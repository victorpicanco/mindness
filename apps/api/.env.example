NODE_ENV=development
HOST=127.0.0.1
PORT=3333
WORKER_HEALTH_PORT=3334
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mindness
PUBLIC_API_URL=http://localhost:3333
PUBLIC_WEB_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-me
# Configure Confirm signup and Reset password templates with:
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery
EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:3000/auth/confirm
ACCOUNTS_CONSENT_VERSION=2026-08-15
# True only when a reverse proxy in front of this process overwrites the
# forwarded header. Reaching the process directly with this on lets a client
# forge its own address and walk past the per-IP rate limit of ADR-007.
TRUST_PROXY=false
REDIS_URL=redis://localhost:6379
DEEPGRAM_API_KEY=replace-me
GOOGLE_CLOUD_PROJECT=mindness-development
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
DEEPGRAM_COST_PER_MINUTE_MICROS=4800
GEMINI_INPUT_COST_PER_MTOK_MICROS=300000
GEMINI_OUTPUT_COST_PER_MTOK_MICROS=2500000
ANALYSIS_QUEUE_CONCURRENCY=5
# Requests allowed per IP, per window, on the public /auth/* routes.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Vertex AI reads Application Default Credentials, not a variable of its own:
# `gcloud auth application-default login` in development, or a service account
# key file pointed at by GOOGLE_APPLICATION_CREDENTIALS in a container.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json

# Only for the opt-in provider suite (`pnpm --filter @mindness/api test:providers`,
# ADR-004). It skips itself when they are absent.
# SUPABASE_PROVIDER_URL=
# SUPABASE_PROVIDER_SECRET_KEY=
