NODE_ENV=development
PORT=3333
WORKER_HEALTH_PORT=3334
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mindness
PUBLIC_API_URL=http://localhost:3333
PUBLIC_WEB_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-me
# Configure Confirm signup and Reset password templates with:
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery
EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:3000/auth/confirm
ACCOUNTS_CONSENT_VERSION=2026-08-15
REDIS_URL=redis://localhost:6379
DEEPGRAM_API_KEY=replace-me
GOOGLE_CLOUD_PROJECT=mindness-development
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDITORY_MODEL=gemini-2.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-2.5-flash
# v1: text-only evaluation. v2: multimodal speech feedback, only after ADR-009 pre-activation checklist.
ANALYSIS_PIPELINE_VERSION=v1
DEEPGRAM_COST_PER_MINUTE_MICROS=4800
GEMINI_INPUT_COST_PER_MTOK_MICROS=300000
GEMINI_OUTPUT_COST_PER_MTOK_MICROS=2500000
ANALYSIS_QUEUE_CONCURRENCY=5
# Requests allowed per IP, per window, on the public /auth/* routes.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
