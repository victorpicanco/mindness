enum QuotaReservationStatus {
  held
  consumed
  released

  @@map("quota_reservation_status")
}

model QuotaCycle {
  id           String             @id @db.Uuid
  accountId    String             @map("account_id") @db.Uuid
  sequence     Int
  startsAt     DateTime           @map("starts_at") @db.Timestamptz(6)
  renewsAt     DateTime           @map("renews_at") @db.Timestamptz(6)
  allowance    Int
  carriedUsage Int                @map("carried_usage")
  createdAt    DateTime           @map("created_at") @db.Timestamptz(6)
  reservations QuotaReservation[]

  @@unique([accountId, startsAt])
  @@index([accountId, renewsAt])
  @@map("quota_cycles")
}

model QuotaReservation {
  id         String                 @id @db.Uuid
  accountId  String                 @map("account_id") @db.Uuid
  cycleId    String?                @map("cycle_id") @db.Uuid
  sessionId  String                 @unique @map("session_id")
  status     QuotaReservationStatus
  createdAt  DateTime               @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?              @map("resolved_at") @db.Timestamptz(6)
  cycle      QuotaCycle?            @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([cycleId, status])
  @@index([accountId, status, resolvedAt])
  @@map("quota_reservations")
}
