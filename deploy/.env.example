# Copy to /opt/mindness/.env on the VPS. Docker Compose reads this file twice:
# to interpolate the variables below into compose.yaml, and as the environment
# of the api and worker containers.

# --- images -----------------------------------------------------------------
# Owner and repository, lowercase. The deploy workflow rewrites IMAGE_TAG on
# every run; pin it by hand to roll back to an earlier commit.
IMAGE_REPO=ghcr.io/<owner>/mindness
IMAGE_TAG=latest

# --- edge -------------------------------------------------------------------
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# --- api --------------------------------------------------------------------
# HOST, PORT, WORKER_HEALTH_PORT, NODE_ENV, TRUST_PROXY and REDIS_URL come from
# compose.yaml.
LOG_LEVEL=info
# Session mode (5432), not transaction mode (6543): `prisma migrate deploy`
# needs prepared statements and DDL.
DATABASE_URL=postgresql://...@aws-0-<region>.pooler.supabase.com:5432/postgres
PUBLIC_API_URL=https://api.example.com
PUBLIC_WEB_URL=https://app.example.com
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=
EMAIL_CONFIRMATION_REDIRECT_URL=https://app.example.com/auth/confirm
ACCOUNTS_CONSENT_VERSION=2026-08-15
DEEPGRAM_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
DEEPGRAM_COST_PER_MINUTE_MICROS=4800
GEMINI_INPUT_COST_PER_MTOK_MICROS=300000
GEMINI_OUTPUT_COST_PER_MTOK_MICROS=2500000
ANALYSIS_QUEUE_CONCURRENCY=5
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Vertex AI authenticates through Application Default Credentials. Put the
# service account key at /opt/mindness/secrets/google-credentials.json — the
# path inside the container is set by compose.yaml.
