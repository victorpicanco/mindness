{
  "name": "mindness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm -r test:e2e",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --no-seed && pnpm --filter @mindness/api db:deploy && pnpm --filter @mindness/api themes:catalog:apply",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.20.0",
    "@next/eslint-plugin-next": "16.2.9",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.0",
    "supabase": "2.116.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.7.3",
      "deepmerge-ts": "^8.0.0",
      "postcss": "^8.5.26",
      "sharp": "^0.35.4",
      "mysql2": "^3.24.3",
      "fast-uri": "^4.1.3"
    },
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/linux-arm64",
      "@ffmpeg-installer/linux-x64",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-arm64",
      "@ffprobe-installer/linux-x64"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
